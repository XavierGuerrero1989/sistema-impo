rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function primaryAdmin() {
      return signedIn()
        && request.auth.token.email in [
          "xavierignacioguerrero@gmail.com",
          "ariel@ptm.cl"
        ];
    }

    function hasRole(roles) {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in roles;
    }

    function canManageUsers() {
      return primaryAdmin() || hasRole(["admin"]);
    }

    match /operaciones/{operacionId} {
      allow read: if signedIn();
      allow create: if primaryAdmin() || hasRole(["admin", "operaciones"]);
      allow update: if primaryAdmin() || hasRole(["admin"]) || (
        hasRole(["operaciones"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado", "logistica", "documentos", "historial",
          "forwarderId", "forwarderNombre", "cotizacionSeleccionadaId",
          "cotizacionesForwarder", "agenteAduanaId", "agenteAduanaNombre",
          "agenteAduanaObservaciones", "updatedAt"
        ])
      ) || (
        hasRole(["finanzas"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "moneda", "totalOperacion", "condicionVenta", "pagosProgramados",
          "adelantos", "pagos", "documentos", "historial",
          "fechaVencimientoPago", "updatedAt"
        ])
      );
      allow delete: if primaryAdmin() || hasRole(["admin"]);
    }

    match /documentos/{docId} {
      allow read: if signedIn();
      allow write: if primaryAdmin() || hasRole(["admin", "operaciones", "finanzas"]);
    }

    match /proveedores/{proveedorId} {
      allow read: if signedIn();
      allow write: if primaryAdmin() || hasRole(["admin", "operaciones"]);
    }

    match /forwarders/{forwarderId} {
      allow read: if signedIn();
      allow write: if primaryAdmin() || hasRole(["admin", "operaciones"]);
    }

    match /agentesAduana/{agenteId} {
      allow read: if signedIn();
      allow write: if primaryAdmin() || hasRole(["admin", "operaciones"]);
    }

    match /usuarios/{userId} {
      allow read: if canManageUsers() || (signedIn() && request.auth.uid == userId);
      allow create: if canManageUsers() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "lectura"
        && request.resource.data.email == request.auth.token.email
      );
      allow update: if canManageUsers() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.activo == resource.data.activo
      );
      allow delete: if canManageUsers() && request.auth.uid != userId;
    }

  }
}
