rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function primaryAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "xavier@brainworks.ar",
          "xavierignacioguerrero@gmail.com",
          "ariel@ptm.cl"
        ];
    }

    function systemOwner() {
      return request.auth != null
        && request.auth.token.email == "xavier@brainworks.ar";
    }

    function accessEnabled() {
      return systemOwner()
        || !firestore.exists(/databases/(default)/documents/configuracion/acceso)
        || firestore.get(
          /databases/(default)/documents/configuracion/acceso
        ).data.suspendido != true;
    }

    function canManageDocuments() {
      return request.auth != null && accessEnabled() && (
        primaryAdmin()
        || firestore.get(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        ).data.role in ["admin", "operaciones", "finanzas"]
      );
    }

    match /operaciones/{operacionId}/documentos/{fileName} {
      allow read: if request.auth != null && accessEnabled();
      allow create, update: if canManageDocuments()
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if canManageDocuments();
    }
  }
}
